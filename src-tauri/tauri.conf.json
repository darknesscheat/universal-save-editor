{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Save Editor",
  "version": "0.1.0",
  "identifier": "com.universalsaveeditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Save Editor",
        "width": 560,
        "height": 480,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Edit your offline game saves without touching raw save files",
    "longDescription": "A local, offline save editor. Each supported game is a plugin describing where its saves live and which values may be changed. Every edit is backed up first and written atomically.",
    "licenseFile": "../LICENSE",
    "resources": { "../plugins": "plugins" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
